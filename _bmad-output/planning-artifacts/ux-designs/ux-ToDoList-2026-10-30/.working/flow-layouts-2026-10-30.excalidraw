s": [], "frameId": null, "roundness": null, "seed": 107353, "version": 1, "versionNonce": 245, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "index": "dI", "text": "Description", "originalText": "Description", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "lineHeight": 1.25}, {"id": "el127", "type": "text", "x": 1752, "y": 432, "width": 233, "height": 30, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 594316, "version": 1, "versionNonce": 158613, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "index": "dJ", "text": "Tab/arrows: fields.  Enter: save.\nEsc: close.", "originalText": "Tab/arrows: fields.  Enter: save.\nEsc: close.", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": null, "lineHeight": 1.25}, {"id": "el128", "type": "text", "x": 1190, "y": 560, "width": 880, "height": 35, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 562686, "version": 1, "versionNonce": 106394, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "index": "dK", "text": "Mouse: click-hold-drag to move or reorder. Ctrl+click selects several; moving is the only multi-item action.\nDrag across a day divider reschedules.", "originalText": "Mouse: click-hold-drag to move or reorder. Ctrl+click selects several; moving is the only multi-item action.\nDrag across a day divider reschedules.", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "lineHeight": 1.25}, {"id": "el129", "type": "text", "x": 1190, "y": 608, "width": 954, "height": 48, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 995045, "version": 1, "versionNonce": 381273, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "index": "dL", "text": "Keys:  Alt+N new   Enter save   Esc close/clear   Up/Down select   Left/Right prev/next day   Ctrl+Up/Down multi-select\n       Ctrl+Left/Right move selection one day   Alt+Up/Down reorder in day   Delete remove (confirm)\n       Space advance state   1/2/3 set state   D tomorrow   W next week   M next month   T today   ? help   [letters proposed]", "originalText": "Keys:  Alt+N new   Enter save   Esc close/clear   Up/Down select   Left/Right prev/next day   Ctrl+Up/Down multi-select\n       Ctrl+Left/Right move selection one day   Alt+Up/Down reorder in day   Delete remove (confirm)\n       Space advance state   1/2/3 set state   D tomorrow   W next week   M next month   T today   ? help   [letters proposed]", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "lineHeight": 1.25}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}